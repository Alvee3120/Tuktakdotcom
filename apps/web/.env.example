# ============================================================
# apps/web — environment variables
# Copy to apps/web/.env.local (dev) or set in your host dashboard.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so they must be present
# when `next build` runs. The API URL is also used by next.config.ts rewrites.
# ============================================================

# Base URL of the API (server fetches + /api/* proxy)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public URL of this web app (metadataBase, share links, JSON-LD)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base for uploaded media (informational; media is served at /api/images)
NEXT_PUBLIC_R2_PUBLIC_URL=http://localhost:8787/api/images

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Server-only secret for the /revalidate route handler.
# Must equal apps/api's REVALIDATE_SECRET.
NEXT_REVALIDATE_SECRET=change-me-revalidate-secret
