{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "drizzle-kit migrate",
    "db:seed": "DATABASE_URL=${DATABASE_URL} tsx drizzle/seed.ts",
    "db:seed:apply": "DATABASE_URL=${DATABASE_URL} psql \"$DATABASE_URL\" -f drizzle/seed.sql",
    "db:seed:apply:remote": "psql \"$DATABASE_URL\" -f drizzle/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.5.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "resend": "^4.1.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}