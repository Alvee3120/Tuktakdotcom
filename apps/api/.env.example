# ============================================================
# apps/api — environment variables
# Copy to apps/api/.env (dev) or provide via your host/process manager.
# ============================================================

# PostgreSQL connection string
DATABASE_URL=postgres://tuktak:tuktak@localhost:5432/tuktak

# Uploaded media — local filesystem. Use a persistent absolute path in prod.
UPLOAD_DIR=./uploads

# Auth — BETTER_AUTH_SECRET MUST be set in production (auth will refuse to boot)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787

# Public URLs / CORS
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Email (Resend) — optional
RESEND_API_KEY=

# Cache revalidation — must equal apps/web's NEXT_REVALIDATE_SECRET
REVALIDATE_SECRET=change-me-revalidate-secret

# Google OAuth — optional (enabled only when both set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookies — set when web/API are on different subdomains (e.g. .tuktakdot.com)
COOKIE_DOMAIN=

# Seed endpoints — optional (disabled when NODE_ENV=production)
SEED_SECRET=

# App — set to "production" on the live server (enables secure cookies)
NODE_ENV=development
PORT=8787
