# ============================================================
# Tuktak.com — environment variables (reference)
#
# This monorepo has two apps with separate env files:
#   apps/api/.env      (or .env.local)  → see apps/api/.env.example
#   apps/web/.env.local                 → see apps/web/.env.example
#
# Copy the per-app templates next to the app that reads them.
# ============================================================

# ─── apps/web ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_R2_PUBLIC_URL=http://localhost:8787/api/images
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Server-only. Must equal apps/api's REVALIDATE_SECRET.
NEXT_REVALIDATE_SECRET=change-me-revalidate-secret

# ─── apps/api ───────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://tuktak:tuktak@localhost:5432/tuktak

# Uploaded media — local filesystem. Point UPLOAD_DIR at a persistent,
# writable volume in production (relative paths resolve from the API cwd).
UPLOAD_DIR=./uploads

# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787

# Public URLs / CORS
#   APP_URL      — public frontend URL (invoice + email links, ISR revalidation)
#   CORS_ORIGINS — comma-separated allow-list for CORS and auth trusted origins
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Email (Resend) — optional; emails are skipped/logged as failed without it
RESEND_API_KEY=

# Cache revalidation — must match apps/web's NEXT_REVALIDATE_SECRET
REVALIDATE_SECRET=change-me-revalidate-secret

# Google OAuth — optional; enabled only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookies — set when web and API are on different subdomains (e.g. .tuktakdot.com)
COOKIE_DOMAIN=

# Seed endpoints — optional; seed routes are disabled when NODE_ENV=production
SEED_SECRET=

# App
NODE_ENV=development
# Optional API port (defaults to 8787)
PORT=8787
