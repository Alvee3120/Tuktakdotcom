# ===========================================
# Tuktak.com Environment Variables
# Copy this file to the appropriate location
# ===========================================

# ─── Frontend (apps/web/.env.local) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.tuktakdot.com
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ─── Backend (apps/api) ─────────────────────────────────

# Database — self-hosted PostgreSQL (Postgres running on your machine/Hetzner)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://tuktak:tuktak@localhost:5432/tuktak

# File storage — local filesystem (upload dir + public base URL)
UPLOAD_DIR=./uploads
PUBLIC_MEDIA_URL=/api/images

# Cloudflare (optional — only if you keep using R2/S3-compatible storage)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_R2_BUCKET_NAME=tuktak-assets

# Auth
BETTER_AUTH_SECRET=your-super-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:8787

# URL routing (env-driven, no hardcoded URLs)
# APP_URL       — public frontend URL
# CORS_ORIGINS  — comma-separated allow-list for CORS + auth trusted origins
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Email (Resend)
RESEND_API_KEY=

# Payments — bKash
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh

# Payments — Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=
NAGAD_BASE_URL=https://api.sandbox.nagad.com

# Payments — SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# App
NODE_ENV=development
LOG_LEVEL=debug